/*
 * Reference genome definitions.
 * -----------------------------
 * Select one with `--genome <key>`. Any field left null is built on the fly by
 * the PREPARE_GENOME subworkflow (faidx, dict, bwa index) and published to
 * `<outdir>/reference/` so subsequent runs can reuse it.
 *
 * Paths are anchored to `params.genomes_base` so the same key resolves on any
 * machine: set genomes_base per site (see conf/uwa.config, conf/setonix.config)
 * or pass `--genomes_base /path/to/refs`.
 *
 * To bypass this file entirely:
 *     --fasta /abs/path/to/reference.fa
 *
 * NOTE ON COORDINATE COMPATIBILITY
 * Variant call sets are only comparable across runs that used the same
 * reference. Joint-called VCFs from different `--genome` keys must not be
 * merged. Each run writes its reference key into the benchmark manifest.
 */

params {
    genomes_base = params.genomes_base ?: "${projectDir}/references"

    genomes {

        // Cicer echinospermum S2Drd065 — the reference used by the earlier
        // all_ce_align cohort. Use this key when results must stay coordinate-
        // compatible with that existing call set.
        'cicec_S2Drd065' {
            fasta       = "${params.genomes_base}/cicec_S2Drd065/cicec.S2Drd065.gnm1.R888.genome_main.fna"
            species     = 'Cicer echinospermum'
            assembly    = 'cicec.S2Drd065.gnm1.R888'
            chr_regex   = '^cicec\\.S2Drd065\\.gnm1\\.chr'
        }

        // Cicer reticulatum — conspecific reference. Best mapping rate for this
        // cohort; not coordinate-compatible with the echinospermum call set.
        'creticulatum' {
            fasta       = "${params.genomes_base}/creticulatum/Creticulatum.genome.fa.gz"
            species     = 'Cicer reticulatum'
            assembly    = 'Creticulatum.genome'
            chr_regex   = '^(Ca|chr)'
        }

        // Cicer arietinum CDC Frontier — cultivated chickpea, the common
        // cross-study reference. Populate genomes_base before use.
        'carietinum_frontier' {
            fasta       = "${params.genomes_base}/carietinum_frontier/cicar.CDCFrontier.gnm3.ann1.fna"
            species     = 'Cicer arietinum'
            assembly    = 'cicar.CDCFrontier.gnm3'
            chr_regex   = '^cicar\\.CDCFrontier\\.gnm3\\.Ca'
        }

        // Cicer pinnatifidum — already fully indexed on the UWA filesystem.
        'cpinnatifidum' {
            fasta       = "${params.genomes_base}/cpinnatifidum/Cpinnatifidum.genome.fa.gz"
            species     = 'Cicer pinnatifidum'
            assembly    = 'Cpinnatifidum.genome'
            chr_regex   = '^(Ca|chr)'
        }
    }
}
