/*
 * Base resource allocation.
 * ------------------------
 * Processes are sized by label, not individually, so the whole pipeline can
 * be re-tuned from one place once benchmarking data comes back.
 *
 * Memory scales with attempt: a task that dies on OOM (SLURM exit 137/140)
 * is retried with more. This matters at 238 samples, where a handful of
 * deep-coverage outliers would otherwise fail the whole run.
 */

process {

    cpus   = { check_max( 1     * task.attempt, 'cpus'   ) }
    memory = { check_max( 6.GB  * task.attempt, 'memory' ) }
    time   = { check_max( 4.h   * task.attempt, 'time'   ) }

    // Expressed as "what must NOT be retried". Enumerating the resource
    // failure codes proved unreliable: SLURM reported an OOM-killed task as
    // exit 125, which was missing from the old allow-list, so the task failed
    // outright instead of retrying with more memory.
    //
    // Exit 1 is a deterministic script error (a GATK USER ERROR, or one of
    // this pipeline's own output guards) and retrying cannot help. Everything
    // else retries, with memory scaled by task.attempt above.
    errorStrategy = { task.exitStatus == 1 ? 'finish' : 'retry' }
    maxRetries    = 4
    maxErrors     = '-1'

    withLabel: process_single {
        cpus   = { check_max( 1                  , 'cpus'   ) }
        memory = { check_max( 4.GB  * task.attempt, 'memory' ) }
        time   = { check_max( 2.h   * task.attempt, 'time'   ) }
    }
    withLabel: process_low {
        cpus   = { check_max( 2     * task.attempt, 'cpus'   ) }
        memory = { check_max( 8.GB  * task.attempt, 'memory' ) }
        time   = { check_max( 4.h   * task.attempt, 'time'   ) }
    }
    withLabel: process_medium {
        cpus   = { check_max( 8     * task.attempt, 'cpus'   ) }
        memory = { check_max( 32.GB * task.attempt, 'memory' ) }
        time   = { check_max( 8.h   * task.attempt, 'time'   ) }
    }
    withLabel: process_high {
        cpus   = { check_max( 16    * task.attempt, 'cpus'   ) }
        memory = { check_max( 64.GB * task.attempt, 'memory' ) }
        time   = { check_max( 16.h  * task.attempt, 'time'   ) }
    }
    withLabel: process_long {
        time   = { check_max( 48.h  * task.attempt, 'time'   ) }
    }
    withLabel: process_high_memory {
        memory = { check_max( 128.GB * task.attempt, 'memory' ) }
    }

    // ---- Process-specific overrides ----
    //
    // Sized from the 24-sample run (results/bench24, trace-bench24-20260924).
    // Measured values per process:
    //
    //   process                    cores  cpu%   medRSS  maxRSS  medWall
    //   BWA_MEM                       16   89%    13.8G   31.7G      40m
    //   GATK4_MARKDUPLICATES           4   36%    33.5G   43.2G       4m   (84.4G via sacct)
    //   GATK4_HAPLOTYPECALLER          4   66%     4.7G    6.7G      26m
    //   GATK4_GENOMICSDBIMPORT         4   25%    14.5G   14.7G      34m
    //   GATK4_GENOTYPEGVCFS            4   22%    14.0G   20.3G      59m
    //   FASTP                          8   54%     2.5G    5.4G       1m
    //   FASTQC                         8   24%     1.6G    1.8G       1m
    //   BWA_INDEX                     16    6%     1.0G    1.0G       8m
    //   SAMTOOLS_MERGE                 4   97%     0.0G    0.0G       1m
    //   SAMTOOLS_STATS                 2   59%     0.0G    0.0G       3m
    //   GATK4_VARIANTFILTRATION        4   26%     1.6G    1.6G      10m
    //   MULTIQC                        8    7%     0.2G    0.2G       0m
    //
    // TWO THINGS THE 24-SAMPLE RUN DOES NOT COVER:
    //
    // 1. Coverage depth. bench_24 selected the Bari* samples; the deepest is
    //    Bari1_092 at ~73x. The full cohort contains Besev_079 at ~146x, twice
    //    that, in a single 38.6 GB FASTQ. Per-sample memory is therefore given
    //    roughly 2x the observed maximum rather than a tight margin -- fastp
    //    was already OOM-killed on that sample at 32 GB.
    //
    // 2. Cohort size. GENOMICSDBIMPORT and GENOTYPEGVCFS hold every sample's
    //    data for one interval simultaneously, so their footprint grows with
    //    the cohort in a way 24 samples cannot reveal. These are deliberately
    //    left heavily over-provisioned. Do not trim them on the basis of the
    //    24-sample measurement; re-measure at full cohort first.

    // ---------- Read QC ----------
    // 54% of 8 cores is reasonable. Memory raised well above the 5.4 G observed
    // because Besev_079 (82.7 Gbp, 38.6 GB) was OOM-killed at 32 GB.
    withName: 'FASTP' {
        cpus   = { check_max( 8                                , 'cpus'   ) }
        memory = { check_max( 64.GB * (2 ** (task.attempt - 1)), 'memory' ) }
        time   = { check_max( 8.h   * task.attempt             , 'time'   ) }
    }

    // 24% of 8 cores: FastQC barely parallelises. 3 cores, and the extra cores
    // only made it harder to schedule across 476 tasks.
    withName: 'FASTQC' {
        cpus   = { check_max( 3                               , 'cpus'   ) }
        memory = { check_max( 8.GB * (2 ** (task.attempt - 1)), 'memory' ) }
        time   = { check_max( 4.h  * task.attempt             , 'time'   ) }
    }

    // ---------- Reference preparation ----------
    // 6% of 16 cores; bwa index is effectively single-threaded. 1.0 G observed.
    withName: 'BWA_INDEX' {
        cpus   = { check_max( 4                                , 'cpus'   ) }
        memory = { check_max( 16.GB * (2 ** (task.attempt - 1)), 'memory' ) }
        time   = { check_max( 8.h   * task.attempt             , 'time'   ) }
    }

    withName: 'NORMALISE_FASTA|SAMTOOLS_FAIDX|GATK4_CREATESEQUENCEDICTIONARY|BUILD_INTERVALS' {
        cpus   = { check_max( 2                               , 'cpus'   ) }
        memory = { check_max( 8.GB * (2 ** (task.attempt - 1)), 'memory' ) }
        time   = { check_max( 4.h                             , 'time'   ) }
    }

    // ---------- Alignment ----------
    // 89% of 16 cores is excellent: keep the cores. Memory cut from 128 G to
    // 64 G -- twice the 31.7 G observed, to absorb Besev_079.
    withName: 'BWA_MEM|BWAMEM2_MEM' {
        cpus   = { check_max( 16                               , 'cpus'   ) }
        memory = { check_max( 64.GB * (2 ** (task.attempt - 1)), 'memory' ) }
        time   = { check_max( 24.h  * task.attempt             , 'time'   ) }
    }

    // 97% of 4 cores. Memory is trivial (91 MB observed); 64 G was absurd.
    withName: 'SAMTOOLS_MERGE' {
        cpus   = { check_max( 4                               , 'cpus'   ) }
        memory = { check_max( 8.GB * (2 ** (task.attempt - 1)), 'memory' ) }
        time   = { check_max( 8.h  * task.attempt             , 'time'   ) }
    }

    // The memory-hungriest per-sample step. sacct recorded 84.4 G on Bari1_092
    // (~73x); Besev_079 is twice as deep, so 128 G base doubling to 512 G.
    withName: 'GATK4_MARKDUPLICATES' {
        cpus   = { check_max( 4                                 , 'cpus'   ) }
        memory = { check_max( 128.GB * (2 ** (task.attempt - 1)), 'memory' ) }
        time   = { check_max( 12.h   * task.attempt             , 'time'   ) }
    }

    withName: 'SAMTOOLS_INDEX|SAMTOOLS_STATS|TABIX_TABIX|GATK4_INDEXFEATUREFILE' {
        cpus   = { check_max( 2                               , 'cpus'   ) }
        memory = { check_max( 8.GB * (2 ** (task.attempt - 1)), 'memory' ) }
        time   = { check_max( 4.h  * task.attempt             , 'time'   ) }
    }

    // ---------- Per-sample variant calling ----------
    // 66% of 4 cores, 6.7 G observed across 192 tasks. 24 G gives ~3.5x
    // headroom for deeper samples while staying easy to schedule -- this is the
    // highest-count process at full cohort (1,288 tasks).
    withName: 'GATK4_HAPLOTYPECALLER' {
        cpus   = { check_max( 4                                , 'cpus'   ) }
        memory = { check_max( 24.GB * (2 ** (task.attempt - 1)), 'memory' ) }
        time   = { check_max( 24.h  * task.attempt             , 'time'   ) }
    }

    // Merging one sample's interval shards. Not present in the 24-sample run,
    // so sized conservatively rather than from measurement.
    withName: 'GATK4_MERGEVCFS' {
        cpus   = { check_max( 4                                , 'cpus'   ) }
        memory = { check_max( 32.GB * (2 ** (task.attempt - 1)), 'memory' ) }
        time   = { check_max( 8.h   * task.attempt             , 'time'   ) }
    }

    // ---------- Joint genotyping: DELIBERATELY OVER-PROVISIONED ----------
    // These two hold every sample's data for one interval at once. At 24
    // samples they used 14.7 G and 20.3 G, but that says nothing about 161 --
    // the relationship is expected to be steeply non-linear, and an OOM here
    // occurs after every other stage has already completed, so it is the most
    // expensive possible place to be wrong.
    //
    // Cores are raised even though measured efficiency was 22-25%: GATK's
    // GenotypeGVCFs is largely single-threaded, so the extra cores mainly buy
    // scheduling room on a shared node rather than speed. Memory is the real
    // constraint and is what these figures are about.
    //
    // Re-measure at full cohort before reducing either of these.
    withName: 'GATK4_GENOMICSDBIMPORT' {
        cpus   = { check_max( 8                                  , 'cpus'   ) }
        memory = { check_max( 256.GB * (2 ** (task.attempt - 1)) , 'memory' ) }
        time   = { check_max( 48.h   * task.attempt              , 'time'   ) }
    }

    withName: 'GATK4_GENOTYPEGVCFS' {
        cpus   = { check_max( 8                                  , 'cpus'   ) }
        memory = { check_max( 512.GB * (2 ** (task.attempt - 1)) , 'memory' ) }
        time   = { check_max( 48.h   * task.attempt              , 'time'   ) }
    }

    // ---------- Gather, filter, report ----------
    withName: 'BCFTOOLS_CONCAT' {
        cpus   = { check_max( 4                                , 'cpus'   ) }
        memory = { check_max( 32.GB * (2 ** (task.attempt - 1)), 'memory' ) }
        time   = { check_max( 12.h  * task.attempt             , 'time'   ) }
    }

    // 1.6 G observed, but it walks the whole cohort VCF, which grows.
    withName: 'GATK4_VARIANTFILTRATION' {
        cpus   = { check_max( 4                                , 'cpus'   ) }
        memory = { check_max( 32.GB * (2 ** (task.attempt - 1)), 'memory' ) }
        time   = { check_max( 24.h  * task.attempt             , 'time'   ) }
    }

    withName: 'VCF_PREP_PCA|VCF_SPLIT_CHROM|VCF_SUBSET_LOCI' {
        cpus   = { check_max( 4                                , 'cpus'   ) }
        memory = { check_max( 32.GB * (2 ** (task.attempt - 1)), 'memory' ) }
        time   = { check_max( 12.h  * task.attempt             , 'time'   ) }
    }

    // 7% of 8 cores, 0.2 G. Reporting only.
    withName: 'MULTIQC' {
        cpus   = { check_max( 2                                , 'cpus'   ) }
        memory = { check_max( 16.GB * (2 ** (task.attempt - 1)), 'memory' ) }
        time   = { check_max( 4.h                              , 'time'   ) }
    }
}
