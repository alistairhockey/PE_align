/*
 * Minimal end-to-end test.
 *
 * Exercises every stage -- reference indexing, interval scatter, alignment,
 * per-sample merge, duplicate marking, joint genotyping across more than one
 * interval, filtering and the PCA fork -- on a reference and read set small
 * enough to finish on a login node in minutes.
 *
 *   nextflow run . -profile test,conda --outdir test_results
 */

params {
    max_cpus   = 4
    max_memory = '12.GB'
    max_time   = '2.h'

    trim_reads           = true
    intervals_min_length = 1000

    // Both downstream forks on, so the test covers them too.
    run_winpca           = true
    pca_maf              = 0.0
    pca_max_missing      = 1.0

    benchmark_label      = 'test'
}

process {
    // Never run compute on a login node: the test uses the scheduler too.
    executor       = 'slurm'
    queue          = 'work'
    resourceLimits = [ cpus: 4, memory: 12.GB, time: 2.h ]
}

executor {
    name            = 'slurm'
    queueSize       = 20
    submitRateLimit = '10/1min'
}

apptainer {
    enabled    = true
    autoMounts = true
    runOptions = '--bind /group,/scratch'
}
