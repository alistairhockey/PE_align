/*
 * UWA HPC (Rocky 9, SLURM) — the benchmarking site.
 * Partition `work`: 12 nodes x 96 cores x ~1.5 TB, 3-day wall limit.
 *
 * Usage:  nextflow run . -profile uwa,apptainer --input samplesheet.csv
 */

params {
    max_cpus     = 96
    max_memory   = '1400.GB'
    max_time     = '24.h'
}

process {
    executor       = 'slurm'
    queue          = 'benchmarking'
    // Stage into node-local storage; GPFS metadata load from 238 samples of
    // small GATK interval tasks is otherwise the bottleneck.
    scratch        = true
    // WARNING: symlink staging couples every task to the continued existence
    // of its upstream task's work directory. Deleting a work directory to free
    // space will break any run that still symlinks outputs from it -- a
    // deleted BWA_INDEX directory made every BWA_MEM fail with
    // "fail to locate the index files", even though the index itself had been
    // published safely to <outdir>/reference/.
    //
    // It is kept because copying staged inputs would roughly double work-dir
    // size, which matters more here than the coupling. The rule that follows
    // from it: never delete a work directory that a live or resumable run
    // depends on, and do not share one session across two work directories.
    stageInMode    = 'symlink'
    stageOutMode   = 'rsync'

    // Keep the scheduler from being flooded by the per-interval fan-out.
    maxForks       = 200
}

executor {
    name            = 'slurm'
    queueSize       = 150
    submitRateLimit = '20/1min'
    pollInterval    = '30 sec'
}

apptainer {
    enabled    = true
    autoMounts = true
    cacheDir   = System.getenv('NXF_APPTAINER_CACHEDIR') ?: "${projectDir}/.apptainer_cache"
    // /group and /scratch are not bind-mounted by default on this host.
    runOptions = '--bind /group,/scratch'
}

// Work directory defaults to SCRATCH, not /group.
//
// /group is a quota-managed project filesystem and a full cohort needs ~1.4 TB
// of transient work space, which exhausts it: a 20 GB write to /group failed at
// 248 MB while the same write to scratch succeeded. Nextflow work directories
// are exactly the kind of large, short-lived data scratch exists for.
//
// SCRATCH IS USUALLY PURGED on a fixed schedule. That is fine for the work
// directory, which is disposable, but published results must be copied
// somewhere durable before the purge window. See docs/Troubleshooting.md.
workDir = System.getenv('NXF_WORK')
          ?: ( System.getenv('MYSCRATCH')
               ? "${System.getenv('MYSCRATCH')}/PE_align/work"
               : "${projectDir}/work" )

// Container cache likewise -- shared where a group cache exists, per-user
// otherwise. Never under /home.

cleanup = false
