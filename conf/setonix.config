/*
 * Pawsey Setonix — the target production system.
 * ----------------------------------------------
 * Setonix compute nodes are dual AMD EPYC 7763: 128 cores, 230 GB usable RAM
 * (~1.79 GB/core). Accounting differs by partition:
 *
 *   work        exclusive whole-node   1 node-hour  = 128 SU
 *   long        exclusive whole-node   1 node-hour  = 128 SU
 *   highmem     exclusive, 980 GB RAM  charged at a higher rate
 *
 * Because `work` is charged per whole node, requesting 16 cores costs the same
 * as requesting 128. The pipeline therefore packs tasks per node rather than
 * submitting many small jobs -- see the maxForks/queueSize settings and the
 * SU model in bin/estimate_su.py.
 *
 * Usage:  nextflow run . -profile setonix,singularity --input samplesheet.csv
 */

params {

    // Setonix has two relevant CPU node types:
    //   work / long   128 cores, ~230 GB   (~1.79 GB per core)
    //   highmem       128 cores, ~980 GB
    //
    // max_memory is set to the highmem node because GATK4_GENOTYPEGVCFS needs
    // ~512 GB for a cohort this size -- measured, see conf/base.config. Capping
    // at 230 GB here would silently shrink that request and reproduce the OOM
    // on Setonix. The queue closure below routes each task to a partition that
    // can actually hold it.
    max_cpus     = 128
    max_memory   = '980.GB'
    max_time     = '96.h'

    // Pawsey project code, e.g. --setonix_account pawsey0001
    setonix_account = System.getenv('PAWSEY_PROJECT') ?: null
}

process {
    executor    = 'slurm'
    // Route by what the task actually needs: anything above a standard node's
    // usable memory must go to highmem, or SLURM will never schedule it.
    queue       = {
        task.memory  && task.memory > 230.GB ? 'highmem'
      : task.time    && task.time   > 24.h   ? 'long'
      :                                        'work'
    }
    clusterOptions = { params.setonix_account ? "--account=${params.setonix_account}" : '' }

    // Setonix mandates node-local scratch for IO-heavy work.
    scratch     = '$MYSCRATCH'
    stageInMode = 'symlink'
    stageOutMode= 'rsync'

    // Memory must be requested in proportion to cores on a shared-node queue,
    // otherwise SLURM rounds the charge up to whole nodes anyway.
    resourceLimits = [ cpus: 128, memory: 980.GB, time: 96.h ]
}

executor {
    name            = 'slurm'
    queueSize       = 1024
    submitRateLimit = '10 sec'
    pollInterval    = '30 sec'
}

singularity {
    enabled     = true
    autoMounts  = true
    // Pawsey guidance: never run or cache containers under /home. Fall back
    // to MYSCRATCH rather than HOME so a missing MYSOFTWARE cannot silently
    // put the image cache somewhere Pawsey asks you not to use it from.
    cacheDir    = "${System.getenv('MYSOFTWARE') ?: System.getenv('MYSCRATCH') ?: '/scratch'}/.singularity"
    // Pawsey guidance: never run containers from /home.
    runOptions  = '--bind /scratch,/software'
}

// Setonix: work directory MUST be on /scratch, never /home or /software.
workDir = "${System.getenv('MYSCRATCH') ?: '/scratch'}/PE_align/work"
