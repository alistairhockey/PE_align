/*
 * UWA `benchmarking` partition -- a single dedicated node (k003).
 *
 *   96 cores, ~1.5 TB, 24 h wall limit, no contention.
 *
 * The point of this partition is clean measurements: nothing else is running
 * on the node, so wall times reflect the work rather than the queue. Use it
 * for the scaling runs that feed the allocation case.
 *
 *   sbatch bin/run_pipeline.sbatch -profile uwa,benchmarking,apptainer,bench_8 ...
 *
 * THE 24 H CAP IS THE CATCH. conf/base.config asks for 72 h on BWA_MEM,
 * GENOMICSDBIMPORT and GENOTYPEGVCFS, taken from values tested on the work
 * partition (3-day limit). SLURM rejects any job whose requested time exceeds
 * the partition maximum -- permanently, with PartitionTimeLimit, not as a
 * queue wait -- so those tasks would never start. max_time below caps every
 * request at 24 h.
 *
 * What that means in practice:
 *   - Alignment and HaplotypeCaller fit comfortably. At ~8x median coverage
 *     on a ~700 Mb genome, BWA_MEM is hours, not days.
 *   - Very deep samples may not. Besev_079 is ~146x, roughly 19x the median,
 *     and could exceed 24 h. It is not in bench_2/bench_8.
 *   - Joint genotyping at full cohort size will not fit. GENOTYPEGVCFS also
 *     wants 512 GB, which is a third of this node. Run that stage on `work`
 *     (3 days) instead of here.
 *
 * So: benchmark the per-sample stages here, and treat joint genotyping as a
 * separate exercise on `work`.
 */

params {
    max_cpus   = 96
    max_memory = '1400.GB'
    max_time   = '24.h'        // hard partition limit -- do not raise
}

process {
    executor = 'slurm'
    queue    = 'benchmarking'

    // One node, 96 cores. BWA_MEM at 16 cpus means ~6 concurrent alignments;
    // letting Nextflow submit far more just fills the queue behind them.
    maxForks = 24
}

executor {
    name            = 'slurm'
    queueSize       = 48
    submitRateLimit = '20/1min'
    pollInterval    = '30 sec'
}
