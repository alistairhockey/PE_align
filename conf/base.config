/*
 * Base resource allocation.
 * ------------------------
 * Processes are sized by label, not individually, so the whole pipeline can
 * be re-tuned from one place once benchmarking data comes back.
 *
 * Memory scales with attempt: a task that dies on OOM (SLURM exit 137/140)
 * is retried with more. This matters at 238 samples, where a handful of
 * deep-coverage outliers would otherwise fail the whole run.
 */

process {

    cpus   = { check_max( 1     * task.attempt, 'cpus'   ) }
    memory = { check_max( 6.GB  * task.attempt, 'memory' ) }
    time   = { check_max( 4.h   * task.attempt, 'time'   ) }

    // Retry on the exit codes that mean "killed", which on SLURM is almost
    // always the cgroup OOM killer (137 = SIGKILL, 140 = wall/mem limit).
    // Memory scales with task.attempt above, so each retry gets more.
    errorStrategy = { task.exitStatus in [104,134,137,139,140,143,247] ? 'retry' : 'finish' }
    maxRetries    = 4
    maxErrors     = '-1'

    withLabel: process_single {
        cpus   = { check_max( 1                  , 'cpus'   ) }
        memory = { check_max( 4.GB  * task.attempt, 'memory' ) }
        time   = { check_max( 2.h   * task.attempt, 'time'   ) }
    }
    withLabel: process_low {
        cpus   = { check_max( 2     * task.attempt, 'cpus'   ) }
        memory = { check_max( 8.GB  * task.attempt, 'memory' ) }
        time   = { check_max( 4.h   * task.attempt, 'time'   ) }
    }
    withLabel: process_medium {
        cpus   = { check_max( 8     * task.attempt, 'cpus'   ) }
        memory = { check_max( 32.GB * task.attempt, 'memory' ) }
        time   = { check_max( 8.h   * task.attempt, 'time'   ) }
    }
    withLabel: process_high {
        cpus   = { check_max( 16    * task.attempt, 'cpus'   ) }
        memory = { check_max( 64.GB * task.attempt, 'memory' ) }
        time   = { check_max( 16.h  * task.attempt, 'time'   ) }
    }
    withLabel: process_long {
        time   = { check_max( 48.h  * task.attempt, 'time'   ) }
    }
    withLabel: process_high_memory {
        memory = { check_max( 128.GB * task.attempt, 'memory' ) }
    }

    // ---- Process-specific overrides ----
    //
    // PROVENANCE: these attempt-1 values are not estimates. They come from
    // resource settings empirically tested against the C. echinospermum
    // cohort (all_ce_align/Gunas062v2/modules.nf) on a comparable ~700 Mb
    // Cicer genome, where they were found sufficient to avoid OOM.
    //
    // Earlier versions of this file used considerably lower figures --
    // BWA_MEM 48 GB, HaplotypeCaller 16 GB, GenotypeGVCFs 64 GB -- which were
    // guesses, and too low. Do not reduce these without a trace to justify it;
    // bin/summarise_benchmark.py reports p95 peak RSS per process and is the
    // right basis for tightening them.
    //
    // The retry ladder sits on top: memory escalates per attempt, so these are
    // the floor rather than the ceiling.

    // Tested: 16 cpus / 128 GB / 72 h.
    withName: 'BWA_MEM|BWAMEM2_MEM' {
        cpus   = { check_max( 16                              , 'cpus'   ) }
        memory = { check_max( 128.GB * (2 ** (task.attempt - 1)), 'memory' ) }
        time   = { check_max( 72.h                            , 'time'   ) }
    }

    // Tested: 64 GB. Java heap is derived from task.memory in the module
    // rather than the fixed -Xmx4g the original used inside this allocation.
    withName: 'GATK4_MARKDUPLICATES' {
        cpus   = { check_max( 4                                , 'cpus'   ) }
        memory = { check_max( 64.GB * (2 ** (task.attempt - 1)), 'memory' ) }
        time   = { check_max( 24.h                             , 'time'   ) }
    }

    // Tested: 64 GB / 24 h.
    withName: 'SAMTOOLS_MERGE' {
        cpus   = { check_max( 4                                , 'cpus'   ) }
        memory = { check_max( 64.GB * (2 ** (task.attempt - 1)), 'memory' ) }
        time   = { check_max( 24.h                             , 'time'   ) }
    }

    // Tested: 64 GB / 24 h. Large chromosomes dominate -- PBA_HatTrick Chr5 is
    // 127 Mb, so a per-interval task is not a small unit of work.
    withName: 'GATK4_HAPLOTYPECALLER' {
        cpus   = { check_max( 4                                , 'cpus'   ) }
        memory = { check_max( 64.GB * (2 ** (task.attempt - 1)), 'memory' ) }
        time   = { check_max( 24.h  * task.attempt             , 'time'   ) }
    }

    // Tested: 64 GB / 72 h. Holds every sample's gVCF for one interval, so
    // memory scales with cohort size; 161 samples is larger than the cohort
    // these figures were measured on, hence the doubling ladder.
    withName: 'GATK4_GENOMICSDBIMPORT' {
        cpus   = { check_max( 4                                , 'cpus'   ) }
        memory = { check_max( 64.GB * (2 ** (task.attempt - 1)), 'memory' ) }
        time   = { check_max( 72.h                             , 'time'   ) }
    }

    // Tested: 512 GB / 72 h. This is the single largest allocation in the
    // pipeline and the one that determines which Pawsey partition is usable:
    // Setonix work/long nodes have ~230 GB, so this step needs `highmem`.
    // See docs/Benchmarking.md.
    withName: 'GATK4_GENOTYPEGVCFS' {
        cpus   = { check_max( 4                                 , 'cpus'   ) }
        memory = { check_max( 512.GB * (2 ** (task.attempt - 1)), 'memory' ) }
        time   = { check_max( 72.h                              , 'time'   ) }
    }

    // Variant filtering walks the cohort VCF; sized well below genotyping but
    // above the generic medium label.
    withName: 'GATK4_VARIANTFILTRATION' {
        cpus   = { check_max( 4                                , 'cpus'   ) }
        memory = { check_max( 64.GB * (2 ** (task.attempt - 1)), 'memory' ) }
        time   = { check_max( 24.h                             , 'time'   ) }
    }

    // Index/stat steps: cheap, short, and numerous. Never retry-escalate these
    // into large allocations, they queue badly.
    withName: 'SAMTOOLS_INDEX|SAMTOOLS_FAIDX|TABIX_TABIX|GATK4_INDEXFEATUREFILE' {
        cpus   = { check_max( 1    , 'cpus'   ) }
        memory = { check_max( 8.GB , 'memory' ) }
        time   = { check_max( 4.h  , 'time'   ) }
    }
}
