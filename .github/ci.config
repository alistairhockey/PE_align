/*
 * CI-only overrides: GitHub runners have no scheduler and 2 cores / 7 GB.
 * The `test` profile targets SLURM, so this switches execution back to local.
 */
process {
    executor       = 'local'
    queue          = null
    resourceLimits = [ cpus: 2, memory: 6.GB, time: 1.h ]
}

// A GitHub runner has no scheduler, so local execution is correct here and is
// declared explicitly -- the pipeline refuses to run locally by default.
params {
    executor_name         = 'local'
    allow_local_execution = true
}
executor {
    name      = 'local'
    queueSize = 2
}
