# ---- Nextflow runtime ----
.nextflow/
.nextflow.log*
work/
results/
benchmarks/
report*.html
timeline*.html
trace*.txt
dag*.html
*.pid

# ---- Credentials: NEVER commit ----
# Pawsey Acacia / AWS keys live in ~/.nextflow/config or a local secrets file.
# conf/secrets.config is git-ignored; conf/secrets.config.template is committed.
conf/secrets.config
.env
*.pem
*.key
credentials
aws_credentials

