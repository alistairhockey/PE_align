/*
 * PE_align — Cicer reticulatum WGS alignment and joint variant calling
 * ---------------------------------------------------------------------
 * Portable configuration. Nothing here is site-specific: every path is a
 * parameter and every execution environment is a profile.
 */

params {
    // ---- Input ----
    // Either point at an NCBI SRA run table and let the pipeline resolve,
    // download and assemble the cohort itself:
    //     --sra_metadata SraRunTable.txt
    // or supply a ready samplesheet (sample,run,fastq_1,fastq_2):
    //     --input samplesheet.csv
    sra_metadata           = null
    input                  = null
    reads_dir              = null      // reuse FASTQs already on disk
    download_reads         = true      // false = require every FASTQ present
    max_download_jobs      = 8         // ENA throttles above ~8 connections
    sra_layout             = 'PAIRED'  // 'ANY' to disable the layout filter
    sra_assay              = null      // e.g. 'WGS'
    sra_organism           = null      // e.g. 'Cicer reticulatum'
    bench_subset           = null      // use only the first N samples
    outdir                 = 'results'

    // ---- Reference ----
    // The only reference input is an assembly FASTA. Everything derived from
    // it -- .fai, .dict, bwa index, scatter intervals -- is built on first use
    // and published to <outdir>/reference/ for reuse. Swapping reference is
    // therefore just a different --fasta.
    fasta                  = null      // REQUIRED: genome assembly (.fa/.fna/.fa.gz)
    fasta_fai              = null      // optional prebuilt index, else built
    fasta_dict             = null      // optional prebuilt dict,  else built
    bwa_index              = null      // optional prebuilt bwa index dir, else built
    chr_regex              = null      // restrict calling to matching sequences
    skip_fasta_normalisation = false   // CRLF/header cleanup before indexing

    // ---- Scatter / intervals ----
    intervals              = null      // BED or GATK .interval_list; null = derive from .fai
    scatter_count          = 0         // 0 = one interval per sequence in the .fai
    intervals_min_length   = 0         // drop reference sequences shorter than this

    // ---- Stage toggles ----
    aligner                = 'bwa'     // 'bwa' (bwa-mem) | 'bwa-mem2'
    trim_reads             = true
    skip_qc                = false
    skip_markduplicates    = false
    skip_variant_calling   = false
    skip_multiqc           = false

    // ---- Variant filtering ----
    skip_filtering         = false
    snp_filter_expression  = 'QD < 2.0 || FS > 60.0 || MQ < 40.0 || MQRankSum < -12.5 || ReadPosRankSum < -8.0 || SOR > 3.0'
    indel_filter_expression= 'QD < 2.0 || FS > 200.0 || ReadPosRankSum < -20.0 || SOR > 10.0'

    // ---- Downstream forks (see subworkflows/local/downstream.nf) ----
    // Produce analysis-ready inputs for windowed and locus-specific PCA.
    run_winpca             = false
    run_locus_pca          = false
    loci_bed               = null      // regions for locus-specific PCA
    pca_maf                = 0.05
    pca_max_missing        = 0.10
    pca_ld_window          = 50
    pca_ld_step            = 10
    pca_ld_r2              = 0.2

    // ---- Benchmarking ----
    // Always on. This pipeline exists partly to produce an allocation case.
    tracedir               = "${params.outdir}/benchmarks"
    benchmark_label        = null      // free-text tag recorded in the trace filename

    // ---- Resource ceilings (overridden per-profile) ----
    max_cpus               = 32
    max_memory             = '256.GB'
    max_time               = '72.h'

    // ---- Misc ----
    publish_dir_mode       = 'copy'
    validate_params        = true
    help                   = false
}

// Base resource allocation by process label
includeConfig 'conf/base.config'

// Optional local secrets (Acacia/AWS keys). Git-ignored; absent by default.
// includeConfig is not conditional in Nextflow, so this is opt-in via profile.

profiles {

    // ---------- Execution environments ----------
    standard {
        process.executor = 'local'
    }

    uwa {
        includeConfig 'conf/uwa.config'
    }

    setonix {
        includeConfig 'conf/setonix.config'
    }

    slurm {
        process.executor = 'slurm'
    }

    // ---------- Software provisioning ----------
    // These deliberately do NOT set cacheDir. Profiles are applied in the
    // order given, so `-profile setonix,singularity` would otherwise clobber
    // the site's cache location with a generic one -- and on Setonix that
    // means running containers from /home, which Pawsey asks you not to do.
    // Nextflow already honours NXF_APPTAINER_CACHEDIR / NXF_SINGULARITY_CACHEDIR
    // natively, so the env var remains the portable way to set this.
    apptainer {
        apptainer.enabled    = true
        apptainer.autoMounts = true
        conda.enabled        = false
        docker.enabled       = false
    }

    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
        conda.enabled          = false
        docker.enabled         = false
    }

    docker {
        docker.enabled       = true
        docker.runOptions    = '-u $(id -u):$(id -g)'
        conda.enabled        = false
        apptainer.enabled    = false
    }

    conda {
        conda.enabled        = true
        conda.channels       = ['conda-forge', 'bioconda', 'defaults']
        docker.enabled       = false
        apptainer.enabled    = false
    }

    // ---------- Test / scaling ----------
    test {
        includeConfig 'conf/test.config'
    }

    // Benchmarking sweeps: subset the cohort to N samples.
    bench_2  { params.bench_subset = 2  }
    bench_8  { params.bench_subset = 8  }
    bench_24 { params.bench_subset = 24 }
}

// ---------------------------------------------------------------------
// Benchmarking instrumentation
// ---------------------------------------------------------------------
// A stable run tag so repeated runs do not clobber each other's evidence.
def bench_tag = params.benchmark_label ?: new java.util.Date().format('yyyyMMdd-HHmmss')

trace {
    enabled   = true
    overwrite = false
    file      = "${params.tracedir}/trace-${bench_tag}.txt"
    // The fields the Pawsey allocation case is built from.
    fields    = 'task_id,hash,native_id,process,tag,name,status,exit,module,container,cpus,time,disk,memory,attempt,submit,start,complete,duration,realtime,queue,%cpu,%mem,rss,vmem,peak_rss,peak_vmem,rchar,wchar,syscr,syscw,read_bytes,write_bytes,vol_ctxt,inv_ctxt,workdir,script'
}

report {
    enabled   = true
    overwrite = false
    file      = "${params.tracedir}/report-${bench_tag}.html"
}

timeline {
    enabled   = true
    overwrite = false
    file      = "${params.tracedir}/timeline-${bench_tag}.html"
}

dag {
    enabled   = true
    overwrite = false
    file      = "${params.tracedir}/dag-${bench_tag}.html"
}

manifest {
    name            = 'PE_align'
    author          = 'Alistair Hockey'
    description     = 'Paired-end short-read alignment and joint variant calling with resource benchmarking'
    mainScript      = 'main.nf'
    nextflowVersion = '>=24.04.0'
    version         = '1.0.0'
}

// Fail fast on obviously wrong resource requests rather than queueing forever.
def check_max(obj, type) {
    if (type == 'memory') {
        try {
            if (obj.compareTo(params.max_memory as nextflow.util.MemoryUnit) == 1)
                return params.max_memory as nextflow.util.MemoryUnit
            else
                return obj
        } catch (all) { return obj }
    } else if (type == 'time') {
        try {
            if (obj.compareTo(params.max_time as nextflow.util.Duration) == 1)
                return params.max_time as nextflow.util.Duration
            else
                return obj
        } catch (all) { return obj }
    } else if (type == 'cpus') {
        try {
            return Math.min(obj as int, params.max_cpus as int)
        } catch (all) { return obj }
    }
}
