/*
 * CI-only overrides: GitHub runners have no scheduler and 2 cores / 7 GB.
 * The `test` profile targets SLURM, so this switches execution back to local.
 */
process {
    executor       = 'local'
    resourceLimits = [ cpus: 2, memory: 6.GB, time: 1.h ]
}
executor {
    name      = 'local'
    queueSize = 2
}
